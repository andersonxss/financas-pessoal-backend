NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173
# Ative apenas quando houver exatamente um proxy reverso confiável diante da API.
TRUST_PROXY=false
# Em produção com app.exemplo.com e api.exemplo.com, use .exemplo.com
COOKIE_DOMAIN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Owner used only by migration/bootstrap commands.
POSTGRES_USER=local_dev_user
POSTGRES_PASSWORD=replace-with-a-strong-migration-password
POSTGRES_DB=finance

# Restricted runtime role. It must remain NOSUPERUSER and NOBYPASSRLS.
POSTGRES_APP_USER=finance_app
POSTGRES_APP_PASSWORD=replace-with-a-different-strong-runtime-password

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Mailtrap Email Sandbox: https://mailtrap.io/pt/fake-smtp-server/
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Finance Sistem <no-reply@finance.local>

# Usadas somente por `npm run bootstrap:admin`
BOOTSTRAP_TENANT_SLUG=principal
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
